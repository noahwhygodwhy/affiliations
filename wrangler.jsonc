{
    "name": "affiliations",
    "main": "./src/worker.ts",
    "compatibility_date": "2026-08-21",
    "assets": {
        "directory": "./dist/affiliations/browser"
    },
    "secrets_store_secrets": [
        {
        "binding": "TestSecret",
        "store_id": "867282d07e2644be82888434e4cf30dc",
        "secret_name": "TestSecret"
        }
    ],
    "d1_databases": [
        {
        "binding": "daily_ids", // available in your Worker on env.DB
        "database_name": "daily_ids",
        "database_id": "66c8b59e-7431-42a9-abc8-529739d600cd"
        }
    ],
    "triggers":
    {
        "crons": ["59 23 LW * *"]
    },
    "observability":
    {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces":
        {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}